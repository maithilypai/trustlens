# ==============================================================================
# TRUSTLENS Backend Configuration Environment Variables
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Application Debug Mode (keep false in production to prevent stack trace leakage)
DEBUG=false

# Allowed CORS Origins (comma-separated list)
# Note: 10.0.2.2 is Android emulator alias for host loopback 127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000

# Maximum permitted URL length for incoming analysis requests
MAX_URL_LENGTH=2048

# Google Safe Browsing API Configuration (Subject to Google Safe Browsing API terms)
# Leave empty to run with local structural heuristics only
SAFE_BROWSING_API_KEY=

# Safe Browsing Client Identity
SAFE_BROWSING_CLIENT_ID=trustlens-backend
SAFE_BROWSING_CLIENT_VERSION=1.0.0

# Timeout in seconds for external threat intelligence calls
THREAT_INTEL_TIMEOUT_SECONDS=4.0
