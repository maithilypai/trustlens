<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext HTTP is permitted for local development (e.g. Android Emulator loopback 10.0.2.2,
      localhost, 127.0.0.1, and local private network development addresses).
      Note: Android domain-config tags do not support raw IP addresses or CIDR notation.
      Enabling cleartext in base-config enables local development against local backend servers.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
